{
	"name": "flavorithm",
	"version": "1.0.0",
	"description": "Flavorithm — Where flavor meets algorithms. Your thoughtful kitchen companion.",
	"scripts": {
		"dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js dev",
		"build": "vite build",
		"preview": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js preview",
		"start": "node --env-file-if-exists=.env server.mjs",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p ./tsconfig.service-worker.json && tsc --noEmit -p ./tsconfig.scripts.json",
		"test": "node --test tests/*.test.ts",
		"seed:dev": "node scripts/seed-dev.mjs",
		"catalog:update": "node scripts/update-provider-endpoints.mjs",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"prepare": "node -e \"if (process.env.NODE_ENV !== 'production') import('husky').then(({default: husky}) => husky())\"",
		"test:smoke": "node scripts/smoke-test.mjs",
		"test:sso": "node scripts/sso-smoke-test.mjs",
		"readiness": "node --env-file-if-exists=.env scripts/readiness.mjs"
	},
	"keywords": [],
	"type": "module",
	"dependencies": {
		"jose": "^6.2.18",
		"marked": "^18.3.0",
		"openid-client": "^6.9.1",
		"sharp": "^0.35.5",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@lucide/svelte": "^1.79.0",
		"@skeletonlabs/skeleton": "^5.0.6",
		"@sveltejs/adapter-node": "^6.0.5",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.2",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26.6.6",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.2",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "~4.2.0",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.8"
	},
	"private": true,
	"lint-staged": {
		"*": "prettier --write --ignore-unknown"
	},
	"imports": {
		"#lib": "./src/lib",
		"#lib/*": "./src/lib/*"
	},
	"engines": {
		"node": ">=24.0.0"
	}
}

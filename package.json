{
	"name": "flavorithm",
	"version": "1.0.0",
	"description": "Flavorithm — Where flavor meets algorithms. Your thoughtful kitchen companion.",
	"scripts": {
		"dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js dev",
		"build": "vite build",
		"preview": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js preview",
		"start": "node --env-file-if-exists=.env server.mjs",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "node --experimental-strip-types --test tests/*.test.ts",
		"seed:dev": "node --experimental-strip-types scripts/seed-dev.mjs",
		"catalog:update": "node scripts/update-provider-endpoints.mjs",
		"format": "prettier --write .",
		"test:smoke": "node scripts/smoke-test.mjs",
		"test:sso": "node scripts/sso-smoke-test.mjs",
		"readiness": "node --env-file-if-exists=.env scripts/readiness.mjs"
	},
	"keywords": [],
	"type": "module",
	"dependencies": {
		"@lucide/svelte": "^1.62.0",
		"@skeletonlabs/skeleton": "^5.0.1",
		"@skeletonlabs/skeleton-svelte": "^5.0.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"jose": "^6.2.13",
		"marked": "^18.1.2",
		"openid-client": "^6.8.8",
		"sharp": "^0.35.5",
		"svelte": "^5.57.3",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.5",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/node": "^26.6.5",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte-check": "^4.7.7"
	},
	"private": true,
	"imports": {
		"#lib": "./src/lib",
		"#lib/*": "./src/lib/*"
	},
	"engines": {
		"node": ">=24.0.0"
	}
}

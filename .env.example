# Local SQLite file. In production, point this at a writable persistent volume.
FLAVORITHM_DB_PATH=./data/flavorithm.sqlite

# adapter-node listener settings
HOST=0.0.0.0
PORT=3000

# Optional recipe search. This is a server-side Brave Search API key.
# Provider API keys for AI features are supplied per request in the app.
# BRAVE_SEARCH_API_KEY=

# Set to the public HTTPS origin when running behind a reverse proxy.
# ORIGIN=https://flavorithm.example.com

# Optional password recovery email (verified Resend sender)
RESEND_API_KEY=
EMAIL_FROM=Flavorithm <kitchen@your-domain.example>

# ChatGPT plan OAuth works locally without a client ID or API key.
# Hosted deployments need an OpenAI-approved client with ChatGPT plan scopes.
# OPENAI_OAUTH_CLIENT_ID=oaiapp_your_registered_client
# OPENAI_OAUTH_REDIRECT_URI=https://your-domain.example/api/connections/chatgpt/callback
# OPENAI_OAUTH_CLIENT_SECRET=
# OPENAI_OAUTH_CLIENT_AUTH_METHOD=none
# Hosted encryption key: exactly 32 random bytes encoded as standard base64.
# Generate privately; keep stable and back it up separately from the database.
# FLAVORITHM_OAUTH_ENCRYPTION_KEY=

# Local SQLite file. In production, point this at a writable persistent volume.
FLAVORITHM_DB_PATH=./data/flavorithm.sqlite

# adapter-node listener settings
HOST=0.0.0.0
PORT=3000

# Authentication mode: local (default), oidc, or proxy.
# OIDC uses the configured identity provider's issuer and an authorization-code client.
# FLAVORITHM_AUTH_MODE=local
# FLAVORITHM_AUTH_MODE=oidc
# FLAVORITHM_OIDC_ISSUER=https://auth.example.com/application/o/flavorithm/
# FLAVORITHM_OIDC_CLIENT_ID=
# FLAVORITHM_OIDC_CLIENT_SECRET=
# FLAVORITHM_OIDC_CLIENT_AUTH_METHOD=post
# FLAVORITHM_OIDC_REDIRECT_URI=https://flavorithm.example.com/auth/callback
# FLAVORITHM_OIDC_SESSION_TTL_SECONDS=3600
#
# Proxy mode is for a trusted reverse proxy / forward-auth gateway. The proxy must
# overwrite identity headers from the authenticated provider and add this secret.
# FLAVORITHM_AUTH_MODE=proxy
# FLAVORITHM_PROXY_SHARED_SECRET=
# FLAVORITHM_PROXY_SECRET_HEADER=x-flavorithm-proxy-secret
# Authentik defaults; other gateways can map their stable user ID, email and name.
# FLAVORITHM_PROXY_SUBJECT_HEADER=x-authentik-uid
# FLAVORITHM_PROXY_EMAIL_HEADER=x-authentik-email
# FLAVORITHM_PROXY_NAME_HEADER=x-authentik-name
# FLAVORITHM_PROXY_ISSUER=flavorithm:proxy
# Set the gateway logout URL to enable a useful sign-out action in proxy mode.
# FLAVORITHM_PROXY_LOGOUT_URL=https://flavorithm.example.com/outpost.goauthentik.io/sign_out

# Optional recipe search. This is a server-side Brave Search API key.
# Provider API keys for AI features are supplied per request in the app.
# BRAVE_SEARCH_API_KEY=

# Set to the public HTTPS origin when running behind a reverse proxy.
# ORIGIN=https://flavorithm.example.com

# Optional password recovery email (verified Resend sender)
RESEND_API_KEY=
EMAIL_FROM=Flavorithm <kitchen@your-domain.example>

# ChatGPT plan OAuth works locally without a client ID or API key.
# Hosted deployments need an OpenAI-approved client with ChatGPT plan scopes.
# OPENAI_OAUTH_CLIENT_ID=oaiapp_your_registered_client
# OPENAI_OAUTH_REDIRECT_URI=https://your-domain.example/api/connections/chatgpt/callback
# OPENAI_OAUTH_CLIENT_SECRET=
# OPENAI_OAUTH_CLIENT_AUTH_METHOD=none
# Hosted encryption key: exactly 32 random bytes encoded as standard base64.
# Generate privately; keep stable and back it up separately from the database.
# FLAVORITHM_OAUTH_ENCRYPTION_KEY=
